# Copy to .env (never commit .env to version control)
OWNER_EMAIL=your_email@example.com
OWNER_PASSWORD=your_secure_host_password_here
PORT=3000
NODE_ENV=production
# Set to 1 only behind a trusted reverse proxy (Render, Railway, nginx)
TRUST_PROXY=0
# Optional: persistent folder for the database and uploads
# DATA_DIR=/var/data
